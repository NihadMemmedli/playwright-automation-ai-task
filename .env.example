# Base URL of the system under test
BASE_URL=https://qa-practice.netlify.app

# ─── Self-healing AI ────────────────────────────────────────────
# Disabled by default. Enable explicitly to incur API costs (cloud providers).
AI_HEALING_ENABLED=false

# Provider: anthropic | openrouter | ollama
AI_HEALING_PROVIDER=anthropic

# ── Anthropic (default) ─────────────────────────────────────────
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_HEALING_MODEL=claude-haiku-4-5-20251001

# ── OpenRouter (paid SaaS, multi-model) ─────────────────────────
# Get a key at https://openrouter.ai/keys
# Browse models at https://openrouter.ai/models
# OPENROUTER_API_KEY=sk-or-...
# AI_HEALING_MODEL=anthropic/claude-3.5-haiku

# ── Ollama (local, free, offline-capable) ───────────────────────
# Install Ollama from https://ollama.com, then pull a model:
#   ollama pull qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434
# AI_HEALING_MODEL=qwen2.5-coder:7b

# Hard caps to prevent runaway spend / runaway loops
AI_HEALING_MAX_PER_TEST=3
AI_HEALING_MAX_PER_RUN=10

# ─── Logging ────────────────────────────────────────────────────
LOG_LEVEL=info
